{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "molu-calendar",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "molu.midori-lab.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/data/events.json",
      "/data/published.json",
      "/feeds/*",
      "/resource/admin/*",
      "/vendor/litert-lm/0.17.1/*.wasm",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "molu-admin",
      "database_id": "bd517cb4-1ad2-493f-a422-be7b4928f1ad",
    },
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "molu-admin-images" }],
  "observability": { "enabled": true },
}
